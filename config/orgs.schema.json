{
  "$ref": "#/definitions/AdoMcpOrgRegistry",
  "definitions": {
    "AdoMcpOrgRegistry": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "orgs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,30}$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "adoOrg": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,49}$"
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "core",
                    "work",
                    "work-items",
                    "search",
                    "test-plans",
                    "repositories",
                    "wiki",
                    "pipelines",
                    "advanced-security"
                  ]
                },
                "minItems": 1
              },
              "auth": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "pat"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9-]{1,127}$"
                      }
                    },
                    "required": ["type", "secret"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "entra-sp"
                      },
                      "tenantId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "clientId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9-]{1,127}$"
                      }
                    },
                    "required": ["type", "tenantId", "clientId", "secret"],
                    "additionalProperties": false
                  }
                ]
              },
              "clientKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9-]{1,127}$"
                },
                "minItems": 1,
                "maxItems": 2
              },
              "toolPolicy": {
                "type": "object",
                "properties": {
                  "extraAllow": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "extraDeny": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "additionalProperties": false,
                "default": {
                  "extraAllow": [],
                  "extraDeny": []
                }
              },
              "limits": {
                "type": "object",
                "properties": {
                  "ratePerMinute": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "default": 120
                  },
                  "maxResponseChars": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "default": 60000
                  }
                },
                "additionalProperties": false,
                "default": {
                  "ratePerMinute": 120,
                  "maxResponseChars": 60000
                }
              },
              "instructions": {
                "type": "string"
              }
            },
            "required": ["alias", "adoOrg", "domains", "auth", "clientKeys"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["version", "orgs"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
