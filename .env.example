# Local development only. Copy to .env.local (git-ignored). Never commit real values.
NODE_ENV=development
PORT=8080
ORG_REGISTRY_PATH=config/orgs.json
CHILD_TIMEOUT_MS=60000
MAX_CONCURRENT_CHILDREN=6

# EnvSecretProvider: SECRET__<NAME_UPPER_SNAKE> maps to Key Vault secret name
# Example: secret name "ado-coolops-pat" -> SECRET__ADO_COOLOPS_PAT
SECRET__ADO_COOLOPS_PAT=
SECRET__MCP_COOLOPS_KEY_A=
SECRET__MCP_COOLOPS_KEY_B=
SECRET__MCP_ADMIN_KEY=

# Production uses Key Vault via managed identity instead:
# KEY_VAULT_URI=https://<vault>.vault.azure.net/

# Optional: override official ADO MCP binary for tests
# ADO_MCP_BIN=test/fixtures/fake-ado-mcp.mjs
